# Copia estas variables a services/brasaland-api/.env y completa los valores de 4Geeks.
LLM_API_KEY=
LLM_API_BASE_URL=
RAG_EMBEDDING_MODEL=
RAG_GENERATION_MODEL=

RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_API_KEY=
RAG_MIN_SCORE=0.35

# Alternativa: FastEmbed local para embeddings y Groq para generacion.
# Exportar una misma clave local aleatoria de 32+ caracteres en ambas variables.
# BRASALAND_LOCAL_LLM_KEY=
# LLM_API_KEY=
# LLM_API_BASE_URL=http://127.0.0.1:8010/v1
# RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# RAG_GENERATION_MODEL=<modelo-de-chat-disponible-en-tu-cuenta-Groq>
# GROQ_API_KEY=
# GROQ_GENERATION_MODEL=<mismo-modelo-real-que-RAG_GENERATION_MODEL>
# BRASALAND_EMBED_CACHE=/tmp/brasaland-embeddings
