# JWT
BRASALAND_JWT_SECRET=change-me-to-a-secure-random-string
BRASALAND_JWT_EXPIRE_MINUTES=480

# TinyDB
BRASALAND_DB_PATH=brasaland_db.json

# Secret used to sign session tokens. Generate a unique value in production.
BRASALAND_AUTH_SECRET=replace-with-a-long-random-secret
# Resend transactional email configuration
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=Brasaland <onboarding@resend.dev>
FRONTEND_BASE_URL=http://localhost:5500/uis/auth
RESET_TOKEN_TTL_MINUTES=30
